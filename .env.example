# ─── API base URL (pick ONE approach) ───────────────────────────────────────
#
# Option A — named preset (see src/config/api.js → API_ENVIRONMENTS):
#   REACT_APP_API_ENV=local
#   REACT_APP_API_ENV=production
#
# Option B — full URL (overrides REACT_APP_API_ENV):
#   REACT_APP_API_BASE_URL=https://backend-gig.aameego.com/api
#
# Default (no .env): https://backend-gig.aameego.com/api
#
# Local development — use .env.local (gitignored):
#   REACT_APP_API_ENV=local
#   REACT_APP_API_BASE_URL=http://localhost:5001/api
#
# Restart `npm start` after changing env files.

# ─── Firebase web push (FCM) ────────────────────────────────────────────────
# From Firebase console → Project settings → "Workza Web" app config, and
# Cloud Messaging → Web Push certificates (VAPID public key). These are public
# identifiers, not secrets. Leave them empty to turn off web push; the bell still works.
# Keep public/firebase-messaging-sw.js in sync: a service worker can't read env vars.
REACT_APP_FIREBASE_API_KEY=AIzaSyABsm4v4DkhJuU12kT9lwI2ce5p4Vyd-NM
REACT_APP_FIREBASE_AUTH_DOMAIN=workza-908cb.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=workza-908cb
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=639902202501
REACT_APP_FIREBASE_APP_ID=1:639902202501:web:673ecb1f672e0ddffbc7ec
REACT_APP_FIREBASE_VAPID_KEY=BPaUWJOLFH8rZU_hizBCdGHjzLw_YpMW1VcRo-kMcoz9Fi8zw6pkkRFTMr9r9h8MaXpvmrG6FqCQZhVBuXTEo5g
